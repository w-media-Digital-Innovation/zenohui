class Zenohui < Formula
  desc "Terminal UI for exploring Zenoh topics, payloads and connections"
  homepage "https://github.com/w-media-Digital-Innovation/zenohui"
  url @SOURCE_URL@
  version @VERSION@
  sha256 @SHA256@
  license "GPL-3.0-or-later"

  depends_on "rust" => :build

  def fetch
    system "cargo", "fetch", *std_cargo_fetch_args
  end

  def install
    system "cargo", "install", *std_cargo_args
    bash_completion.install "target/completions/zenohui.bash" => "zenohui"
    fish_completion.install "target/completions/zenohui.fish"
    zsh_completion.install "target/completions/_zenohui"
    man1.install Dir["target/manpages/*.1"]
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/zenohui --version")
    assert_match "--no-multicast", shell_output("#{bin}/zenohui --help")
    output = shell_output("#{bin}/zenohui --no-multicast --listen tcp/127.0.0.1:0 clean homebrew/test --dry-run 2>&1")
    assert_match "homebrew/test", output
  end
end
